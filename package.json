{
  "name": "ebay-deal-finder",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:migrate": "DATABASE_URL=file:./data/dev.sqlite prisma migrate deploy",
    "hunt:run": "pnpm --filter @apps/cli hunt:run",
    "scan:run": "pnpm --filter @apps/cli scan:run",
    "worker:start": "pnpm --filter @apps/worker start",
    "wizard:start": "pnpm --filter @apps/wizard start",
    "wizard:oneclick": "pnpm wizard:start"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "undici": "^7.2.1"
  }
}
